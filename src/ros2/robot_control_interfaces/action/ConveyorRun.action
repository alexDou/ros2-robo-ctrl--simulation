# Goal
uint8 RUN_TO_PICKZONE=1
uint8 FLUSH=2
uint8 mode
---
# Result: stop_reason is one of STOPPED_AT_EYE, FLUSH_DONE, HELD_BIN_AWAY, STOPPED, FAULT
bool success
string stop_reason
uint32 exit_count_delta
# Belt travel where the run ended: Gearwheel positions seen earlier are shifted to it.
float64 encoder_mm
---
# Feedback
string belt_state
float32 encoder_mm
