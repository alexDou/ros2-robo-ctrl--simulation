{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ros2-robot-controller-simulation.io/schemas/robot_command.schema.json",
  "title": "RobotCommand",
  "x-datafabric-channel": "command",
  "description": "Canonical schema for inbound commands sent to EdgeNode over WebSocket or DataFabric",
  "type": "object",
  "required": [
    "command_id",
    "sender_id",
    "timestamp_ns",
    "type",
    "payload"
  ],
  "$defs": {
    "palm_actuate_payload": {
      "type": "object",
      "title": "PalmActuatePayload",
      "description": "Typed payload for PALM_ACTUATE command to toggle suction or grasp status",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "title": "PalmAction",
          "enum": [
            "GRASP",
            "RELEASE"
          ],
          "description": "Actuation action to execute on dexterous palm"
        }
      },
      "additionalProperties": false
    },
    "trajectory_execute_payload": {
      "type": "object",
      "title": "TrajectoryExecutePayload",
      "description": "Typed payload for TRAJECTORY_EXECUTE command dispatching canned or custom trajectories",
      "properties": {
        "pose_name": {
          "type": "string",
          "title": "PoseName",
          "enum": [
            "HOME",
            "READY",
            "INSPECT_POSE"
          ],
          "description": "Pre-defined canonical UR5e posture"
        },
        "waypoints": {
          "type": "array",
          "title": "TrajectoryWaypoints",
          "description": "Optional sequence of waypoints for custom trajectory execution",
          "items": {
            "type": "array",
            "title": "ArmJointPositions",
            "description": "UR5e 6-DoF joint angles in radians",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        }
      },
      "additionalProperties": false
    },
    "emergency_stop_payload": {
      "type": "object",
      "title": "EmergencyStopPayload",
      "description": "Typed payload for EMERGENCY_STOP command",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Optional human-readable reason for emergency stop"
        }
      },
      "additionalProperties": false
    },
    "reset_fault_payload": {
      "type": "object",
      "title": "ResetFaultPayload",
      "description": "Typed payload for RESET_FAULT command",
      "properties": {},
      "additionalProperties": false
    },
    "spawn_object_payload": {
      "type": "object",
      "title": "SpawnObjectPayload",
      "description": "Typed payload for SPAWN_OBJECT command",
      "required": [
        "x",
        "y",
        "z",
        "object_type"
      ],
      "properties": {
        "x": {
          "type": "number",
          "description": "Cartesian X in meters (REP-103 robot base frame)"
        },
        "y": {
          "type": "number",
          "description": "Cartesian Y in meters (REP-103 robot base frame)"
        },
        "z": {
          "type": "number",
          "description": "Cartesian Z in meters (clamped to table surface 0.0m)"
        },
        "object_type": {
          "type": "string",
          "title": "SpawnObjectType",
          "enum": [
            "GEAR"
          ],
          "description": "Type of object to spawn"
        }
      },
      "additionalProperties": false
    },
    "clear_workspace_payload": {
      "type": "object",
      "title": "ClearWorkspacePayload",
      "description": "Typed payload for CLEAR_WORKSPACE command",
      "properties": {},
      "additionalProperties": false
    }
  },
  "properties": {
    "command_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID v4 identifying the command"
    },
    "sender_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the originating sender"
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Nanoseconds since Unix epoch when command was dispatched"
    },
    "type": {
      "type": "string",
      "title": "CommandType",
      "enum": [
        "PING",
        "TELEOP_JOINT_TARGET",
        "PALM_ACTUATE",
        "TRAJECTORY_EXECUTE",
        "EMERGENCY_STOP",
        "RESET_FAULT",
        "SPAWN_OBJECT",
        "CLEAR_WORKSPACE"
      ],
      "description": "Operational command type"
    },
    "payload": {
      "type": "object",
      "description": "Command-specific payload arguments"
    }
  },
  "additionalProperties": false
}
