{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handsim.io/schemas/robot_telemetry_event.schema.json",
  "title": "RobotTelemetryEvent",
  "description": "Canonical schema for outbound telemetry events emitted by EdgeNode over DataFabric and WebSocket",
  "type": "object",
  "required": [
    "timestamp_ns",
    "robot_state",
    "joint_positions"
  ],
  "properties": {
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Nanoseconds since Unix epoch when telemetry state was sampled"
    },
    "robot_state": {
      "type": "string",
      "enum": [
        "BOOTING",
        "IDLE",
        "PROCESSING",
        "EXECUTING",
        "FAULT"
      ],
      "description": "Current lifecycle state of the robotic manipulator"
    },
    "joint_positions": {
      "type": "array",
      "description": "UR5e 6-DoF kinematic chain angles in radians",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "inference_metrics": {
      "type": "object",
      "description": "Edge AI inference latency and object classification metrics",
      "required": [
        "latency_ms",
        "confidence",
        "detected_object"
      ],
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0.0,
          "description": "Inference compute latency in milliseconds"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Classification detection confidence score"
        },
        "detected_object": {
          "type": "string",
          "minLength": 1,
          "description": "Detected object class label"
        }
      },
      "additionalProperties": false
    },
    "command_id": {
      "type": "string",
      "description": "Optional command identifier acknowledged by this telemetry event"
    }
  },
  "additionalProperties": false
}
