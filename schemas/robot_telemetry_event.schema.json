{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ros2-robot-controller-simulation.io/schemas/robot_telemetry_event.schema.json",
  "title": "RobotTelemetryEvent",
  "x-datafabric-channel": "telemetry",
  "description": "Canonical schema for outbound telemetry events emitted by EdgeNode over DataFabric and WebSocket",
  "type": "object",
  "required": [
    "timestamp_ns",
    "robot_state",
    "joint_positions",
    "palm_state"
  ],
  "consts": {
    "DEFAULT_ROBOT_ID": {
      "type": "string",
      "value": "arm-ur5",
      "description": "Canonical default robot identifier across all services"
    }
  },
  "$defs": {
    "default_robot_id": {
      "type": "string",
      "const": "arm-ur5",
      "x-constant-name": "DEFAULT_ROBOT_ID",
      "description": "Canonical default robot identifier across all services"
    },
    "canonical_joints": {
      "type": "string",
      "title": "UR5eJoint",
      "x-constant-name": "UR5E_JOINTS",
      "x-constant-alias": "CANONICAL_UR5E_JOINTS",
      "enum": [
        "shoulder_pan_joint",
        "shoulder_lift_joint",
        "elbow_joint",
        "wrist_1_joint",
        "wrist_2_joint",
        "wrist_3_joint"
      ],
      "description": "Canonical UR5e 6-DoF joint names in kinematic sequence"
    }
  },
  "properties": {
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Nanoseconds since Unix epoch when telemetry state was sampled"
    },
    "robot_state": {
      "type": "string",
      "title": "RobotState",
      "enum": [
        "BOOTING",
        "STANDBY",
        "IDLE",
        "EXECUTING",
        "FAULT"
      ],
      "description": "Current lifecycle state of the robotic manipulator"
    },
    "joint_positions": {
      "type": "array",
      "title": "ArmJointPositions",
      "description": "UR5e 6-DoF kinematic chain angles in radians in canonical sequence",
      "prefixItems": [
        { "type": "number", "description": "shoulder_pan_joint angle in radians" },
        { "type": "number", "description": "shoulder_lift_joint angle in radians" },
        { "type": "number", "description": "elbow_joint angle in radians" },
        { "type": "number", "description": "wrist_1_joint angle in radians" },
        { "type": "number", "description": "wrist_2_joint angle in radians" },
        { "type": "number", "description": "wrist_3_joint angle in radians" }
      ],
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "palm_state": {
      "type": "object",
      "title": "PalmState",
      "description": "End-effector dexterous palm pneumatic actuation and grasp status",
      "required": [
        "is_grasped"
      ],
      "properties": {
        "is_grasped": {
          "type": "boolean",
          "default": false,
          "description": "True if suction or grasp is actively engaged, false otherwise"
        }
      },
      "default": {
        "is_grasped": false
      },
      "additionalProperties": false
    },
    "inference_metrics": {
      "type": "object",
      "title": "InferenceMetrics",
      "description": "Edge AI inference latency and object classification metrics",
      "required": [
        "latency_ms",
        "confidence",
        "detected_object"
      ],
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0.0,
          "description": "Inference compute latency in milliseconds"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Classification detection confidence score"
        },
        "detected_object": {
          "type": "string",
          "minLength": 1,
          "description": "Detected object class label"
        }
      },
      "additionalProperties": false
    },
    "command_id": {
      "type": "string",
      "description": "Optional command identifier acknowledged by this telemetry event"
    }
  },
  "additionalProperties": false
}
